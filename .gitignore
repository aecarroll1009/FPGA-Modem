# build/ is the scratch area: generated CORDIC test vectors and Verilator
# build output, both regenerable via cordic/run_sim.sh. Everything
# in it is ignored, but the directory itself is kept so it survives a clone.
build/*
!build/.gitkeep

# syn/output/ is the Quartus scratch area: the project, database, and reports
# are all generated by syn/build.tcl, so none of it is checked in.
syn/output/

__pycache__/
*.py[cod]

# Per-machine Claude Code permissions.
.claude/settings.local.json

.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# HPS streamer binaries
hps/iq_streamd
hps/iq_streamd_fake
